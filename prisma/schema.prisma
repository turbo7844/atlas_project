generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncTrigger {
  AUTOMATIC
  MANUAL
  COMMAND
  WEBHOOK
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum MarketingActualSyncMode {
  PATCH
  SNAPSHOT_OFFER
  SNAPSHOT_CHUNK
  SNAPSHOT_COMMIT
}

enum MarketingActualSnapshotStatus {
  OFFERED
  COMMITTED
  REJECTED
}

enum CashFlowKind {
  INCOME
  EXPENSE
}

model Direction {
  id              String               @id
  name            String               @unique
  sortOrder       Int                  @unique
  marketingPlans  MarketingPlanValue[]
  marketingActual MarketingActual[]
  sales           SalesMonthly[]
  contractorCosts ContractorCost[]
  cashFlows       CashFlowEntry[]
  payrollMonthly  PayrollMonthly[]
}

model DataSource {
  id                  String                  @id @default(cuid())
  key                 String                  @unique
  name                String
  type                String
  enabled             Boolean                 @default(true)
  syncIntervalMinutes Int                     @default(30)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  syncRuns            SyncRun[]
  snapshots           MarketingPlanSnapshot[]
  payrollMonthly      PayrollMonthly[]
  payrollSyncState    PayrollSyncState?
}

model SyncRun {
  id              String                   @id @default(cuid())
  sourceId        String
  trigger         SyncTrigger
  status          SyncStatus
  externalEventId String?                  @unique
  syncMode        MarketingActualSyncMode?
  startedAt       DateTime                 @default(now())
  finishedAt      DateTime?
  rowCount        Int?
  changed         Boolean?
  contentHash     String?
  errorMessage    String?
  source          DataSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshot        MarketingPlanSnapshot?

  @@index([sourceId, startedAt])
}

model MarketingPlanSnapshot {
  id          String               @id @default(cuid())
  sourceId    String
  syncRunId   String               @unique
  year        Int
  contentHash String
  rawPayload  String               @db.Text
  createdAt   DateTime             @default(now())
  source      DataSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  syncRun     SyncRun              @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  values      MarketingPlanValue[]

  @@index([sourceId, createdAt])
  @@index([year])
}

model MarketingPlanValue {
  snapshotId  String
  directionId String
  month       Int
  visits      Int
  leads       Int
  budget      Decimal               @db.Decimal(14, 2)
  conversion  Decimal               @db.Decimal(10, 6)
  cpc         Decimal               @db.Decimal(12, 2)
  cpl         Decimal               @db.Decimal(12, 2)
  snapshot    MarketingPlanSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  direction   Direction             @relation(fields: [directionId], references: [id])

  @@id([snapshotId, directionId, month])
  @@index([directionId, month])
}

model MarketingActual {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  directionId     String
  visits          Int
  leads           Int
  budget          Decimal   @db.Decimal(14, 2)
  spreadsheetId   String
  sheetName       String
  sourceRow       Int
  sourceUpdatedAt DateTime
  updatedAt       DateTime  @updatedAt
  direction       Direction @relation(fields: [directionId], references: [id])

  @@unique([date, directionId])
  @@unique([spreadsheetId, sheetName, sourceRow])
  @@index([date])
  @@index([spreadsheetId, sheetName])
}

model MarketingActualSyncState {
  id            String                           @id @default(cuid())
  spreadsheetId String
  sheetName     String
  revision      Int                              @default(0)
  contentHash   String?
  lastSuccessAt DateTime?
  rowCount      Int                              @default(0)
  maxDate       DateTime?                        @db.Date
  lastError     String?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  sessions      MarketingActualSnapshotSession[]

  @@unique([spreadsheetId, sheetName])
}

model MarketingActualSnapshotSession {
  id           String                         @id @default(cuid())
  snapshotId   String                         @unique
  stateId      String
  contentHash  String
  rowCount     Int
  chunkCount   Int
  headers      Json
  baseRevision Int
  status       MarketingActualSnapshotStatus  @default(OFFERED)
  createdAt    DateTime                       @default(now())
  expiresAt    DateTime
  committedAt  DateTime?
  state        MarketingActualSyncState       @relation(fields: [stateId], references: [id], onDelete: Cascade)
  chunks       MarketingActualSnapshotChunk[]

  @@index([stateId, createdAt])
  @@index([status, expiresAt])
}

model MarketingActualSnapshotChunk {
  sessionId  String
  chunkIndex Int
  rowCount   Int
  payload    Json
  createdAt  DateTime                       @default(now())
  session    MarketingActualSnapshotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, chunkIndex])
}

model SalesMonthly {
  id          String    @id @default(cuid())
  year        Int
  month       Int
  directionId String
  leads       Int
  meetings    Int
  proposals   Int
  contracts   Int
  payments    Int
  revenue     Decimal   @db.Decimal(16, 2)
  direction   Direction @relation(fields: [directionId], references: [id])

  @@unique([year, month, directionId])
  @@index([year, month])
}

model ContractorCost {
  id          String    @id @default(cuid())
  year        Int
  month       Int
  directionId String
  amount      Decimal   @db.Decimal(16, 2)
  direction   Direction @relation(fields: [directionId], references: [id])

  @@unique([year, month, directionId])
  @@index([year, month])
}

model PayrollMonthly {
  id          String     @id @default(cuid())
  sourceId    String
  year        Int
  month       Int
  directionId String
  salary      Decimal    @db.Decimal(16, 2)
  vacationPay Decimal    @db.Decimal(16, 2)
  bonus       Decimal    @db.Decimal(16, 2)
  salesBonus  Decimal    @db.Decimal(16, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  source      DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  direction   Direction  @relation(fields: [directionId], references: [id])

  @@unique([sourceId, year, month, directionId])
  @@index([year, month])
  @@index([directionId, year, month])
}

model PayrollSyncState {
  id            String     @id @default(cuid())
  sourceId      String     @unique
  revision      Int        @default(0)
  contentHash   String?
  lastSuccessAt DateTime?
  employeeCount Int        @default(0)
  rowCount      Int        @default(0)
  latestYear    Int?
  latestMonth   Int?
  lastError     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  source        DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model CashFlowEntry {
  id          String       @id @default(cuid())
  year        Int
  month       Int
  directionId String
  kind        CashFlowKind
  category    String
  amount      Decimal      @db.Decimal(16, 2)
  direction   Direction    @relation(fields: [directionId], references: [id])

  @@unique([year, month, directionId, kind, category])
  @@index([year, month])
}
